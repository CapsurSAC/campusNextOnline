generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                Int           @id @default(autoincrement())
  nombre            String
  apellido          String
  email             String        @unique
  contraseña        String
  rol               RolUsuario
  fechaRegistro     DateTime      @default(now())
  telefono          String?
  dni               String        @unique
  idioma            String?       @default("Español")
  metaSemanal       String?       @default("3 lecciones")
  nivel             String?       @default("Básico")
  progreso          Int           @default(0)
  ultimoAcceso      DateTime?
  inscripciones     Inscripcion[]
  mensajesEnviados  Mensaje[]     @relation("MensajesEnviados")
  mensajesRecibidos Mensaje[]     @relation("MensajesRecibidos")
}

model Curso {
  id            Int           @id @default(autoincrement())
  titulo        String
  descripcion   String
  categoria     String
  imagenPortada String
  duracionHoras Int
  estado        EstadoCurso
  evaluaciones  Evaluacion[]
  inscripciones Inscripcion[]
  lecciones     Leccion[]
}

model Leccion {
  id         Int               @id @default(autoincrement())
  cursoId    Int
  titulo     String
  contenido  String
  orden      Int
  tipo       TipoLeccion
  curso      Curso             @relation(fields: [cursoId], references: [id])
  materiales Material[]
  progresos  ProgresoLeccion[]
}




model Material {
  id          Int          @id @default(autoincrement())
  leccionId   Int
  tipo        TipoMaterial
  descripcion String
  urlArchivo  String
  leccion     Leccion      @relation(fields: [leccionId], references: [id])
}

model Inscripcion {
  id               Int                @id @default(autoincrement())
  usuarioId        Int
  cursoId          Int
  fechaInscripcion DateTime           @default(now())
  curso            Curso              @relation(fields: [cursoId], references: [id])
  usuario          Usuario            @relation(fields: [usuarioId], references: [id])
  progresos        ProgresoLeccion[]
  respuestas       RespuestaUsuario[]
}

model ProgresoLeccion {
  id              Int         @id @default(autoincrement())
  inscripcionId   Int
  leccionId       Int
  completado      Boolean
  fechaCompletado DateTime?

  inscripcion     Inscripcion @relation(fields: [inscripcionId], references: [id])
  leccion         Leccion     @relation(fields: [leccionId], references: [id])

  @@unique([inscripcionId, leccionId], name: "inscripcionId_leccionId") // ✅ NOMBRE EXPLÍCITO
}

model Evaluacion {
  id          Int                @id @default(autoincrement())
  cursoId     Int
  titulo      String
  descripcion String
  tipo        TipoEvaluacion
  curso       Curso              @relation(fields: [cursoId], references: [id])
  respuestas  RespuestaUsuario[]
}

model RespuestaUsuario {
  id             Int         @id @default(autoincrement())
  inscripcionId  Int
  evaluacionId   Int
  respuesta      String
  fechaRespuesta DateTime    @default(now())
  evaluacion     Evaluacion  @relation(fields: [evaluacionId], references: [id])
  inscripcion    Inscripcion @relation(fields: [inscripcionId], references: [id])
}

model Mensaje {
  id         Int      @id @default(autoincrement())
  emisorId   Int
  receptorId Int
  contenido  String
  fechaEnvio DateTime @default(now())
  emisor     Usuario  @relation("MensajesEnviados", fields: [emisorId], references: [id])
  receptor   Usuario  @relation("MensajesRecibidos", fields: [receptorId], references: [id])
}

enum RolUsuario {
  ADMIN
  ALUMNO
}

enum EstadoCurso {
  ACTIVO
  INACTIVO
}

enum TipoLeccion {
  VIDEO
  LECTURA
  ACTIVIDAD
}

enum TipoMaterial {
  PDF
  VIDEO
  ENLACE
}

enum TipoEvaluacion {
  QUIZ
  TRABAJO
}
